# ====================================================================
# Production Environment Configuration
# Copy this file to .env.production and fill in your values
# ====================================================================

# 1. PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=voice_platform

# 2. Application Security (Generate using: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_32_byte_secret_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days (7 * 24 * 60 minutes)

# 3. AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 4. OpenWA WhatsApp Gateway Security
OPENWA_BASE_URL=https://your-openwa-gateway.onrender.com
OPENWA_API_KEY=your_secure_openwa_api_token_here
OPENWA_SESSION_ID=default
PUBLIC_WEBHOOK_URL=https://your-backend-api.onrender.com

# 5. Frontend & Domain Configuration (Allow Cloudflare Pages & Custom Domain)
FRONTEND_ORIGIN=https://your-frontend.pages.dev,http://localhost:3000

# 6. Campaign & Outreach Limits
CAMPAIGN_CONCURRENCY_LIMIT=5
DEFAULT_PHONE_REGION=IN
