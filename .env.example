# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mydb

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
FRONTEND_ORIGIN=http://localhost:3000

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# WhatsApp Telephony Gateway (OpenWA)
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your-openwa-api-key-optional
OPENWA_SESSION_ID=default
OPENWA_WEBHOOK_SECRET=your-openwa-webhook-secret-optional
PUBLIC_WEBHOOK_URL=https://your-public-tunnel-url.trycloudflare.com

# Redis (for background workers)
REDIS_URL=redis://localhost:6379/0

# Application Settings
MAX_CALL_DURATION=300
MAX_RETRIES=3
CAMPAIGN_CONCURRENCY_LIMIT=5
